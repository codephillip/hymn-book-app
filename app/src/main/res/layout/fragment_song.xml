<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:weightSum="6">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/margin_20">

            <ImageView
                android:id="@+id/backbutton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_backarrow" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NGA NNUNGI"
                android:textColor="@color/blue"
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Medium"
                app:layout_constraintBottom_toBottomOf="@id/backbutton"
                app:layout_constraintStart_toEndOf="@id/backbutton"
                app:layout_constraintTop_toTopOf="@id/backbutton" />

            <TextView
                android:id="@+id/navigation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hymns 3 . 5 verses"
                android:textAppearance="@style/Base.TextAppearance.AppCompat"
                app:layout_constraintBottom_toBottomOf="@id/like"
                app:layout_constraintStart_toStartOf="@id/backbutton"
                app:layout_constraintTop_toTopOf="@id/like" />


            <TextView
                android:id="@+id/song_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/original_songs"
                android:textAppearance="@style/Base.TextAppearance.AppCompat"
                app:layout_constraintBottom_toBottomOf="@id/song_type_icon"
                app:layout_constraintEnd_toStartOf="@id/song_type_icon"
                app:layout_constraintTop_toTopOf="@id/song_type_icon" />

            <ImageView
                android:id="@+id/song_type_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_16"
                app:layout_constraintBottom_toBottomOf="@id/like"
                app:layout_constraintEnd_toStartOf="@id/text_size"
                app:layout_constraintTop_toTopOf="@id/like"
                app:srcCompat="@drawable/ic_down" />

            <TextView
                android:id="@+id/text_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16px"
                android:textAppearance="@style/Base.TextAppearance.AppCompat"
                app:layout_constraintBottom_toBottomOf="@id/text_size_icon"
                app:layout_constraintEnd_toStartOf="@id/text_size_icon"
                app:layout_constraintTop_toTopOf="@id/text_size_icon" />

            <ImageView
                android:id="@+id/text_size_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_16"
                app:layout_constraintBottom_toBottomOf="@id/like"
                app:layout_constraintEnd_toStartOf="@id/like"
                app:layout_constraintTop_toTopOf="@id/like"
                app:srcCompat="@drawable/ic_down" />

            <ImageButton
                android:id="@+id/like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_20"
                android:layout_marginEnd="@dimen/margin_16"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/title"
                app:srcCompat="@drawable/ic_star_black_36dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/bottom_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/margin_16"
            android:layout_marginBottom="@dimen/margin_8"
            android:paddingLeft="@dimen/margin_32"
            android:paddingRight="@dimen/margin_32"
            android:scrollbars="none">

            <TextView
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sample_hymn" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
