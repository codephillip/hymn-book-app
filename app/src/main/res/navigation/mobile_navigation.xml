<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_original">

    <fragment
        android:id="@+id/navigation_original"
        android:name="com.codephillip.app.hymnbook.ui.original.OriginalFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_original" />

    <fragment
        android:id="@+id/favourites_dashboard"
        android:name="com.codephillip.app.hymnbook.ui.dashboard.FavouritesFragment"
        android:label="@string/title_dashboard"
        tools:layout="@layout/fragment_favourites" />

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.codephillip.app.hymnbook.ui.home.HomeFragment"
        android:label="@string/title_home"
